    def end_time(self) -> datetime.datetime:
        """
        The time the universe row becomes available (the file's publication date). The Reader sets
        Time to the prior calendar day so EndTime, one calendar day later, lands on the publication
        date the file is keyed by. EndTime has no setter, so it can never overwrite Time.
        """
