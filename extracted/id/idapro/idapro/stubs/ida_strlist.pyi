    """
    ...

def synth_string_set(*args: Any) -> bool:
    r"""Store what the provider PROVIDER_ID knows about EA. TEXTS replaces everything that provider said about that address before; an empty TEXTS forgets it. Empty texts are ignored, a text repeated in TEXTS is stored once. Storing what is already stored changes nothing in the database. A provider does not have to be registered to store strings; registration only names them in the Strings window. One address holds about one kilobyte of text, shared by all providers. What does not fit is not lost entirely: TEXTS are stored in order, the first one that does not fit is cut at a character boundary, and the ones after it are dropped. What the other providers stored is kept intact. 
            
    :param flags: Synthetic string flags
    :returns: false if TEXTS were cut or dropped, or if nothing could be stored (PROVIDER_ID is SYNTHSTR_PROVIDER_NONE, EA is BADADDR)
    """
    ...

def synth_string_set_strings(provider_id: int, ea: ida_idaapi.ea_t, strings: synth_strings_t) -> bool:
    r"""Store what the provider PROVIDER_ID knows about EA, as synth_string_set() does, with the flags and the relations of each string: the instructions that use or build it (synth_string_t::uses and synth_string_t::parts), which synth_string_get_related() finds it from. A text given several times is stored once, with all their relations. The relations share the room of the texts; those that do not fit are dropped. The fields ea and provider of STRINGS are ignored. 
            
    :returns: false if something was cut or dropped, or if nothing could be stored (PROVIDER_ID is SYNTHSTR_PROVIDER_NONE, EA is BADADDR)
    """
    ...

def synth_string_unregister_provider(id: int) -> bool:
    r"""Unregister the provider ID. The strings it stored stay in the database.
    
    """
    ...

