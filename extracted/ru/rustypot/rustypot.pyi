    def word_order(self) -> builtins.str:
        r"""
        Byte order of multi-byte registers on the wire: "little" or "big".
        """
    @property
    def supports_sync_read(self) -> builtins.bool:
        r"""
        Whether the firmware answers the Sync Read instruction.
        """
    @property
    def supports_broadcast_ping(self) -> builtins.bool:
        r"""
        Whether the firmware answers a ping sent to the broadcast id, which
        `broadcast_scan` relies on.
        """
    @property
    def baudrates(self) -> builtins.dict[builtins.int, builtins.int]:
        r"""
