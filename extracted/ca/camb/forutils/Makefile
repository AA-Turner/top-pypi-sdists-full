#Edit Makefile_compiler to change compiler options

FORUTILS_SRC_DIR ?= .
FORUTILS_MAKEFILE_DIR ?= $(abspath $(FORUTILS_SRC_DIR))
# Keep forutils artefacts alongside CAMB's when CAMB_BUILD_DIR is set.
FORUTILS_BUILD_DIR ?= $(if $(CAMB_BUILD_DIR),$(CAMB_BUILD_DIR)/forutils)

ifeq ($(HASINCLUDED),)
include $(FORUTILS_SRC_DIR)/Makefile_compiler
HASINCLUDED=T
endif

ifeq ($(MPIF90C),)
all: Release Debug
else
all: Release Debug ReleaseMPI DebugMPI
endif

# export all variables to the sub-make below
export

SRCS = MiscUtils.f90 MpiUtils.f90 StringUtils.f90 ArrayUtils.f90 FileUtils.f90 \
	   IniObjects.f90 RandUtils.f90 ObjectLists.f90 MatrixUtils.f90 RangeUtils.f90 \
	   Interpolation.f90

OBJS = $(patsubst %.f90,%.o,$(SRCS))

Release:
	@$(MAKE) OUTPUT_DIR=$(if $(FORUTILS_BUILD_DIR),$(FORUTILS_BUILD_DIR)/Release,Release) F90FLAGS="$(F90RELEASEFLAGS)" $(MAKEOPT) directories

Releaselib:
	@$(MAKE) OUTPUT_DIR=$(if $(FORUTILS_BUILD_DIR),$(FORUTILS_BUILD_DIR)/Releaselib,Releaselib) $(MAKEOPT) directories

ReleaseMPI:
	@$(MAKE) OUTPUT_DIR=$(if $(FORUTILS_BUILD_DIR),$(FORUTILS_BUILD_DIR)/ReleaseMPI,ReleaseMPI) F90C="$(MPIF90C)" F90FLAGS="$(F90RELEASEFLAGS) -DMPI" $(MAKEOPT) directories

Debug:
	@$(MAKE) OUTPUT_DIR=$(if $(FORUTILS_BUILD_DIR),$(FORUTILS_BUILD_DIR)/Debug,Debug) F90FLAGS="$(F90DEBUGFLAGS)" $(MAKEOPT) directories

Debuglib:
	@$(MAKE) OUTPUT_DIR=$(if $(FORUTILS_BUILD_DIR),$(FORUTILS_BUILD_DIR)/Debuglib,Debuglib) $(MAKEOPT) directories

DebugMPI:
	@$(MAKE) OUTPUT_DIR=$(if $(FORUTILS_BUILD_DIR),$(FORUTILS_BUILD_DIR)/DebugMPI,DebugMPI) F90C="$(MPIF90C)" F90FLAGS="$(F90DEBUGFLAGS) -DMPI" $(MAKEOPT) directories

cur_ver := $(shell cat compiler.ver 2>&1 || echo "")
ifneq ($(cur_ver),$(compiler_ver))
$(shell rm -f compiler.ver *.d)
endif

compiler.ver:
	@echo $(compiler_ver) > compiler.ver
	@rm -f *.d

%.o: $(FORUTILS_SRC_DIR)/%.f90 compiler.ver
	$(F90C) $(F90COMMONFLAGS) $(F90FLAGS) -o $*.o -c $<

libforutils.a: $(OBJS) | silent
	$(AREXE) -r libforutils.a $(OBJS)

ifneq ($(FORUTILS_BUILD_DIR),)
FORUTILS_BUILD_OUTPUT_DIRS = $(addprefix $(FORUTILS_BUILD_DIR)/,Release Releaselib ReleaseMPI Debug Debuglib DebugMPI)
clean:
	-rm -f -- $(foreach dir,$(FORUTILS_BUILD_OUTPUT_DIRS),"$(dir)"/*.o "$(dir)"/*.a "$(dir)"/*.d "$(dir)"/*.mod "$(dir)"/compiler.ver "$(dir)"/core)
else
clean:
	-rm -fr Debug* Release*
endif

silent:
	@:

# Build in output dir to get file dependencies correctly and make use
# of delta builds, where only changed files and their dependents are
# rebuild.
directories:
	@mkdir -p $(OUTPUT_DIR)
	$(MAKE) -C $(OUTPUT_DIR) $(MAKEOPT) -f $(FORUTILS_MAKEFILE_DIR)/Makefile FORUTILS_SRC_DIR=$(FORUTILS_MAKEFILE_DIR) libforutils.a

# Include dependency files generated by a previous run of make
-include $(SRCS:.f90=.d)

.PHONY: directories clean Release Debug ReleaseMPI DebugMPI Releaselib Debuglib

#Avoid problems with intel gen-dep
%.h: ;
